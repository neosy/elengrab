# App
APP_NAME=elengrab

# Docker hub
DOCKER_HUB=hub.docker.com

# Docker address
DOCKER_HTTP_ADRR_TAG_LIST=https://${DOCKER_HUB}/v2/neosy/${APP_NAME}/tags/list

# Base image name
APP_IMG_NAME=neosy/${APP_NAME}

# Image tags
APP_IMG_NAME_LATEST=${APP_IMG_NAME}:latest

# Images
APP_IMG=${APP_IMG_NAME}
APP_IMG_LATEST=${APP_IMG_NAME_LATEST}

# Stack name
STACK_NAME=${APP_NAME}

# Services
APP_SERVICE=${APP_NAME}_server

# Ports
HTTP_PORT=51080
