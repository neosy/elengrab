# Log
LOG_FORMAT=console
LOG_LEVEL=info

# port FastHTTP
HTTP_SERVER_PORT=8080

# Redis
REDIS_CONNECTION_TYPE="SIMPLE"
REDIS_PREFIX_KEY="home:elengrab"
#SENTINEL_MASTER_NAME="mymaster"
REDIS_ADDRESSES=192.168.0.11:3101

# SQLite
SQLITE_DATA_DIR=/app_n/sqlite/data

# Application
ELENGRAB_ASSETS_DIR=/app_n/assets
ELENGRAB_DOWNLOADS_DIR=/app_n/downloads
ELENGRAB_LOAD_HISTORY=true
