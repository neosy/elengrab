# Log
LOG_FORMAT=console
LOG_LEVEL=info

# port FastHTTP
HTTP_SERVER_PORT=8080

# SQLite
SQLITE_DATA_DIR=./sqlite/data

# Application
# Dir with yt-dlp
ELENGRAB_DOWNLOADER_BIN_DIR=/usr/local/bin
ELENGRAB_ASSETS_DIR=./assets
ELENGRAB_DOWNLOADS_DIR=./downloads
ELENGRAB_DOWNLOAD_WORKERS=3
ELENGRAB_LOAD_HISTORY=true
ELENGRAB_MAINTENANCE_INTERVAL_UPDATE_HASH=8h
ELENGRAB_MAINTENANCE_INTERVAL_UPDATE_DUPLICATES=1h
