# Logging
ELENGRAB_LOG_FORMAT=console
ELENGRAB_LOG_LEVEL=info

# HTTP server
ELENGRAB_HTTP_SERVER_PORT=8080

# Admin server / pprof
ELENGRAB_ADMIN_SERVER_ENABLE=false
ELENGRAB_ADMIN_SERVER_ADDRESS=0.0.0.0

# SQLite
ELENGRAB_SQLITE_DATA_DIR=/opt/Elengrab/db/data
ELENGRAB_SQLITE_BACKUPS_DIR=/opt/Elengrab/db/backups

# Application directories
ELENGRAB_ASSETS_DIR=/opt/Elengrab/assets
ELENGRAB_MEDIA_DIR=/opt/Elengrab/media
ELENGRAB_DOWNLOADS_DIR=/opt/Elengrab/downloads
ELENGRAB_COOKIES_DIR=/opt/Elengrab/cookies

# Application mode
ELENGRAB_MODE=public_readonly
ELENGRAB_BASE_URL=https://example.com

# Admin account
ELENGRAB_ADMIN_LOGIN=admin
ELENGRAB_ADMIN_PASSWORD=admin

# Downloads
ELENGRAB_DOWNLOAD_WORKERS=3
ELENGRAB_ALLOW_COOKIES=false

# Duplicate handling
ELENGRAB_DELETE_DUPLICATES_UNIQUENESS_SCOPE=per_user

# Maintenance
ELENGRAB_MAINTENANCE_UPDATE_HASH_INTERVAL=8h
ELENGRAB_MAINTENANCE_DELETE_DUPLICATES_INTERVAL=1h
ELENGRAB_MAINTENANCE_DELETE_MISSING_DOWNLOADS_INTERVAL=30m
ELENGRAB_MAINTENANCE_DELETE_FAILED_DOWNLOADS_INTERVAL=1h
ELENGRAB_MAINTENANCE_ENABLE_MOVE_UNMATCHED_FILES=true
ELENGRAB_MAINTENANCE_DATABASE_BACKUPS_KEEP=7
