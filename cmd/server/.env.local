# Log
LOG_FORMAT=console
LOG_LEVEL=info

# port FastHTTP
HTTP_SERVER_PORT=8080

# SQLite
SQLITE_DATA_DIR=/app_n/sqlite/data
SQLITE_BACKUPS_DIR=/app_n/sqlite/backups

# Application
# Dir with yt-dlp
ELENGRAB_DOWNLOADER_BIN_DIR=/usr/local/bin
ELENGRAB_ASSETS_DIR=/app_n/assets
ELENGRAB_DOWNLOADS_DIR=/app_n/downloads
ELENGRAB_COOKIES_DIR=/app_n/cookies

ELENGRAB_MODE=public
ELENGRAB_BASE_URL=https://example.com
ELENGRAB_ADMIN_LOGIN=admin
ELENGRAB_ADMIN_PASSWORD=admin
ELENGRAB_DOWNLOAD_WORKERS=3
ELENGRAB_DELETE_DUPLICATES_SCOPE=per_user
ELENGRAB_ALLOW_COOKIES=false

ELENGRAB_MAINTENANCE_UPDATE_HASH_INTERVAL=8h
ELENGRAB_MAINTENANCE_DELETE_DUPLICATES_INTERVAL=1h
ELENGRAB_MAINTENANCE_DELETE_MISSING_DOWNLOADS_INTERVAL=30m
ELENGRAB_MAINTENANCE_DELETE_FAILED_DOWNLOADS_INTERVAL=1h
ELENGRAB_MAINTENANCE_ENABLE_MOVE_UNMATCHED_FILES=false
ELENGRAB_MAINTENANCE_DATABASE_BACKUPS_KEEP=7
